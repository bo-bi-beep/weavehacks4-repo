{
  "name": "weavehacks4-repo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "main:agent": "tsx agents/main_agent/index.ts",
    "main:serve": "tsx agents/main_agent/server.ts",
    "sub:agents": "tsx agents/sub_agents/server.ts",
    "weave:smoke": "tsx src/smoke.ts",
    "attack-kb:config": "tsx attack-kb/src/print-config.ts",
    "attack-kb:redis-health": "tsx attack-kb/src/redis/health.ts",
    "attack-kb:iris-health": "tsx attack-kb/src/iris/health.ts",
    "attack-kb:vector-sync": "tsx attack-kb/src/retrieval/sync.ts",
    "attack-kb:context-sync": "tsx attack-kb/src/iris/context-sync.ts",
    "attack-kb:langcache-smoke": "tsx attack-kb/src/iris/langcache-smoke.ts",
    "attack-kb:clear-data": "tsx attack-kb/src/maintenance/clear-data.ts",
    "attack-kb:source-pipeline": "tsx attack-kb/src/source-pipeline/run.ts",
    "attack-kb:source-prefetch": "tsx attack-kb/src/source-pipeline/run-prefetched.ts",
    "attack-kb:probe": "tsx attack-kb/src/probe-demo.ts",
    "attack-kb:ingest": "tsx attack-kb/src/ingest-demo.ts",
    "attack-kb:curation-ui": "tsx attack-kb/src/curation/server.ts",
    "attack-kb:curation-smoke": "tsx attack-kb/src/curation/smoke.ts",
    "attack-kb:evals": "tsx attack-kb/evals/run.ts",
    "attack-kb:server": "tsx attack-kb/src/server.ts",
    "attack-kb:server:prod": "node dist/attack-kb/src/server-start.js",
    "attack-kb:copy-runtime-assets": "node -e \"const fs=require('node:fs'); fs.rmSync('dist/agents/attack_kb',{recursive:true,force:true}); fs.mkdirSync('dist/agents',{recursive:true}); fs.cpSync('agents/attack_kb','dist/agents/attack_kb',{recursive:true});\"",
    "attack-kb:server-smoke": "tsx attack-kb/src/server-smoke.ts",
    "attack-kb:demo": "tsx attack-kb/src/demo/server.ts",
    "attack-kb:demo-smoke": "tsx attack-kb/src/demo/smoke.ts",
    "attack-kb:sandbox-smoke": "tsx attack-kb/src/sandbox-smoke.ts",
    "attack-kb:redis-smoke": "tsx attack-kb/src/storage/redis-smoke.ts",
    "attack-kb:smoke": "tsx attack-kb/src/smoke.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json && npm run attack-kb:copy-runtime-assets"
  },
  "dependencies": {
    "@blaxel/core": "^0.2.87",
    "@openai/agents": "^0.11.6",
    "@openai/agents-extensions": "^0.11.6",
    "dotenv": "^17.4.2",
    "openai": "^6.42.0",
    "redis": "^6.0.0",
    "weave": "^0.15.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
