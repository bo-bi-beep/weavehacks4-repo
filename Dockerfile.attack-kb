# Attack KB HTTP API for Railway.
FROM node:22-slim

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --include=dev

COPY tsconfig.json ./
COPY src ./src
COPY agents ./agents
COPY attack-kb ./attack-kb
COPY .agents ./.agents
COPY .claude ./.claude

RUN npm run build

ENV NODE_ENV=production

CMD ["npm", "run", "attack-kb:server:prod"]
