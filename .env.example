# W&B / Weave
WANDB_API_KEY=
# Optional — entity (team/user) and project name for the Weave trace destination.
# Defaults to project "weavehacks4-your-idea" with no entity when unset.
WANDB_ENTITY=
WANDB_PROJECT=

# Model providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Optional model for the CopilotKit presenter in apps/demo-dashboard.
COPILOT_MODEL=openai/gpt-4o-mini

# Skills loaded into agents/main_agent at startup (comma-separated; none/empty to
# disable). Defaults to loan-approval-agent when unset.
# MAIN_AGENT_SKILLS=loan-approval-agent

# Blaxel sandbox (compute backend for agents/main_agent and agents/sub_agents)
BL_API_KEY=
BL_WORKSPACE=
# Optional sandbox tuning (sensible defaults applied when unset)
BLAXEL_SANDBOX_IMAGE=blaxel/base-image
BLAXEL_SANDBOX_MEMORY=4096
# Region defaults to us-pdx-1 (US West). Others: eu-lon-1, us-was-1
BLAXEL_SANDBOX_REGION=us-pdx-1
# For main_agent: the sandbox name. For sub_agents: a per-agent name prefix.
# BLAXEL_SANDBOX_NAME=

# App
PORT=3000
