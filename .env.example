# W&B / Weave tracing and evals
WANDB_API_KEY=
# Optional — entity (team/user) and project name for the Weave trace destination.
# Defaults to project "weavehacks4-attack-kb" with no entity when unset.
WANDB_ENTITY=
WANDB_PROJECT=weavehacks4-attack-kb

# Direct OpenAI model calls
OPENAI_API_KEY=
# Main Agent (orchestrator) model — defaults to OpenAI GPT-5.5 when unset.
MAIN_AGENT_MODEL=gpt-5.5
# Sub-agents' model — defaults to gpt-5.4-mini when unset.
OPENAI_MODEL=gpt-5.4-mini
# Optional model for the CopilotKit presenter in apps/demo-dashboard.
COPILOT_MODEL=openai/gpt-4o-mini

# Skills loaded into agents/main_agent at startup (comma-separated; none/empty to
# disable). Defaults to loan-approval-agent when unset.
# MAIN_AGENT_SKILLS=loan-approval-agent

# Blaxel sandbox (compute backend for agents/main_agent, agents/sub_agents,
# and live Attack KB sandbox agents)
BL_API_KEY=
BL_WORKSPACE=
# Optional sandbox tuning (sensible defaults applied when unset)
BLAXEL_SANDBOX_IMAGE=blaxel/base-image
BLAXEL_SANDBOX_MEMORY=4096
# Region defaults to us-pdx-1 (US West). Others: eu-lon-1, us-was-1
BLAXEL_SANDBOX_REGION=us-pdx-1
# Packages apk-installed into every sandbox on creation (the Alpine base image
# has no curl). Space-separated; defaults to "curl", set "none" to disable.
# SANDBOX_APK_PACKAGES=curl
# For main_agent: the sandbox name. For sub_agents: a per-agent name prefix.
# BLAXEL_SANDBOX_NAME=

# Sub-agent registry persistence (agents/sub_agents)
# Unset = in-memory registry: state is lost on restart. Set REDIS_URL to persist
# each agent's identity, skills, and chat history so the service survives a
# restart and can run multiple instances.
# REDIS_URL=redis://localhost:6379
# Optional: expire registry entries (seconds) to match the Blaxel sandbox TTL.
# SUBAGENT_TTL_SECONDS=3600
# Optional: Redis key prefix (default "subagent").
# REDIS_KEY_PREFIX=subagent
# Optional sandbox FILESYSTEM continuity across restarts (separate from the
# registry above). When set, micro-VMs are kept alive on shutdown and the service
# re-attaches to them by name on restart, preserving files written mid-run.
# Leave unset (default) to recreate sandboxes from the stored manifest on
# restart. Enable only once you've confirmed the sandbox client can re-attach.
# SUBAGENT_REATTACH=1

# Attack KB multiagent fleet
# Live Attack KB sandbox agents reuse OPENAI_API_KEY plus the Blaxel vars above.
ATTACK_KB_LLM_PROVIDER=openai
ATTACK_KB_SOURCE_GATHERING_MODEL=gpt-5.4-mini
ATTACK_KB_CREDIBILITY_TRIAGE_MODEL=gpt-5.5
ATTACK_KB_CURATOR_MODEL=gpt-5.5
ATTACK_KB_RECOMMENDER_MODEL=gpt-5.5

# Manual live source pipeline: Source Gathering -> Credibility Triage -> KB Curator.
# Source Gathering owns discovery + fetch validation; only the trusted local orchestrator writes Redis after KB Curator returns approved derived artifact inputs.
ATTACK_KB_SOURCE_PIPELINE_MAX_CANDIDATES=5
ATTACK_KB_SOURCE_PIPELINE_MAX_RETRIEVALS=5
ATTACK_KB_SOURCE_PIPELINE_TARGET_ARTIFACTS=50
ATTACK_KB_SOURCE_PIPELINE_MISSION=
# Trusted local retrieval-only bridge for official sources that block sandbox fetches.
# It returns sanitized public-source excerpts to sandbox triage/curation; no secrets, Redis creds, or AUT access.
ATTACK_KB_PREFETCH_MAX_SOURCES=7
ATTACK_KB_PREFETCH_TARGET_ARTIFACTS=40
ATTACK_KB_PREFETCH_CANDIDATE_IDS=
ATTACK_KB_PREFETCH_PERSIST=true

# Canonical Redis connection. Prefer a Redis Cloud compatible URL; use rediss:// when TLS is required.
# REDIS_URL is enough for storage/Iris, vector retrieval, memory, and cache.
# Component-specific URL env vars below are optional overrides only.
REDIS_URL=

# Attack KB LLM cache. Supported providers: disabled, local, redis, langcache.
# redis = exact-key Redis DB cache. langcache = managed Redis LangCache semantic cache service.
ATTACK_KB_LLM_CACHE=disabled
ATTACK_KB_LLM_CACHE_TTL_SECONDS=86400
ATTACK_KB_REDIS_CACHE_URL=
ATTACK_KB_REDIS_CACHE_KEY_PREFIX=attack-kb:llm-cache
ATTACK_KB_REDIS_CACHE_FALLBACK=local
ATTACK_KB_REDIS_CACHE_TIMEOUT_MS=2000

# Full response cache for POST /api/recommendations. Use /api/recommendations/live to bypass for diagnostics.
# Unset = redis when REDIS_URL exists, otherwise local. The cache key ignores options.requestId.
ATTACK_KB_RECOMMENDATION_RESPONSE_CACHE=
ATTACK_KB_RECOMMENDATION_RESPONSE_CACHE_TTL_SECONDS=86400
ATTACK_KB_RECOMMENDATION_RESPONSE_CACHE_URL=
ATTACK_KB_RECOMMENDATION_RESPONSE_CACHE_KEY_PREFIX=attack-kb:recommendation-response-cache
ATTACK_KB_RECOMMENDATION_RESPONSE_CACHE_FALLBACK=local

# Managed Redis LangCache service (separate from REDIS_URL). Required for ATTACK_KB_LLM_CACHE=langcache.
LANGCACHE_HOST=
LANGCACHE_CACHE_ID=
LANGCACHE_API_KEY=
LANGCACHE_THRESHOLD=0.82
ATTACK_KB_LANGCACHE_SEARCH_STRATEGIES=exact
# Keep false unless the LangCache service was created with matching task/model attributes.
ATTACK_KB_LANGCACHE_USE_ATTRIBUTES=false
ATTACK_KB_LANGCACHE_FALLBACK=local
ATTACK_KB_LANGCACHE_TIMEOUT_MS=10000

# Attack KB storage/Iris (local works without Redis; redis/redis-iris uses official Redis client)
ATTACK_KB_STORAGE_ADAPTER=local
ATTACK_KB_LOCAL_STORAGE_PATH=attack-kb/.local/kb.json
# Optional override. Leave blank to use REDIS_URL.
ATTACK_KB_REDIS_IRIS_URL=
# Also used as the Redis Query Engine/RediSearch index name when RedisJSON + FT.* are available.
ATTACK_KB_REDIS_IRIS_INDEX=attack-kb-objects
# Canonical object keys use <namespace>:<index>:object:<id> plus <namespace>:<index>:ids.
ATTACK_KB_REDIS_IRIS_NAMESPACE=attack-kb
# local/true/1 keeps a demo-safe local fallback; disabled/false/0 fails fast.
ATTACK_KB_REDIS_IRIS_FALLBACK=local
# Keep true for deterministic demos. Set false or use the source pipeline/curator writer for clean live-source runs.
ATTACK_KB_SEED_ON_EMPTY=true

# Attack KB main-agent Iris/vector/hybrid retrieval. Local deterministic search is default and uses no APIs.
# Set ATTACK_KB_VECTOR_BACKEND=redis (or auto with REDIS_URL) to materialize chunks
# into Redis hashes and query a RediSearch vector index. This is P0 for main recommendations;
# subagent context-query/spawn-spec generation remains P1.
ATTACK_KB_VECTOR_BACKEND=local # local | redis | auto
# Optional override. Leave blank to use REDIS_URL.
ATTACK_KB_VECTOR_REDIS_URL=
ATTACK_KB_VECTOR_INDEX=attack-kb-vector
ATTACK_KB_VECTOR_KEY_PREFIX=attack-kb:vector
ATTACK_KB_VECTOR_INDEX_ALGORITHM=HNSW # HNSW | FLAT
ATTACK_KB_VECTOR_REDIS_FALLBACK=local
ATTACK_KB_VECTOR_MATERIALIZE_ON_SEARCH=false
ATTACK_KB_VECTOR_DIMENSIONS=384
ATTACK_KB_VECTOR_MAX_CHUNK_CHARS=2400
ATTACK_KB_EMBEDDING_PROVIDER=deterministic # deterministic | openai (OpenAI seam only; real calls deferred)
ATTACK_KB_VECTOR_DETERMINISTIC_SEED=attack-kb-vector-v1
ATTACK_KB_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional Redis health/report naming overrides. Default prefix/streams derive from namespace.
ATTACK_KB_REDIS_KEY_PREFIX=attack-kb
ATTACK_KB_REDIS_EVENTS_STREAM=attack-kb:events
ATTACK_KB_REDIS_CURATION_STREAM=attack-kb:curation:events
# Report-only by default; set to 1 locally to run AUTH/SELECT/PING reachability.
ATTACK_KB_REDIS_HEALTH_CONNECT=0
ATTACK_KB_REDIS_HEALTH_TIMEOUT_MS=2500

# Attack KB Redis DB Agent Memory adapter for run/outcome notes. In auto mode, memory uses
# ATTACK_KB_MEMORY_REDIS_URL when set, otherwise REDIS_URL/ATTACK_KB_REDIS_IRIS_URL when set,
# otherwise an in-process local-memory fallback.
ATTACK_KB_MEMORY_ADAPTER=auto
ATTACK_KB_MEMORY_REDIS_URL=
ATTACK_KB_MEMORY_REDIS_PREFIX=attack-kb:memory
ATTACK_KB_MEMORY_REDIS_FALLBACK=local
ATTACK_KB_MEMORY_REDIS_TIMEOUT_MS=1500

# Managed Redis Agent Memory service (separate from REDIS_URL; preview/Iris service).
# MEMORY_API_KEY is the Agent Memory service/API key, not the Redis database password.
MEMORY_API_BASE_URL=
MEMORY_STORE_ID=
MEMORY_API_KEY=
MEMORY_OWNER_ID=attack-kb-demo
MEMORY_ACTOR_ID=attack-kb
MEMORY_NAMESPACE=attack-kb
MEMORY_SIMILARITY_THRESHOLD=0.7
MEMORY_LIMIT=6

# Managed Redis Context Retriever / Context Surfaces service (separate from REDIS_URL).
# Run npm run attack-kb:context-sync after changing the surface schema or adding templates.
# ATTACK_KB_CONTEXT_RETRIEVER=auto hydrates selected recommendation artifacts through generated MCP tools.
ATTACK_KB_CONTEXT_RETRIEVER=auto
ATTACK_KB_CONTEXT_RETRIEVER_MAX_CALLS=8
ATTACK_KB_CONTEXT_RETRIEVER_TIMEOUT_MS=12000
CTX_ADMIN_KEY=
CTX_SURFACE_ID=
MCP_AGENT_KEY=
CTX_REDIS_INSTANCE_ID=

# Protected data clear command. Required only when intentionally wiping Attack KB Redis data.
# ATTACK_KB_CLEAR_DATA_CONFIRM=delete-attack-kb-data
ATTACK_KB_CLEAR_CONTEXT_PROJECTIONS=true
ATTACK_KB_CLEAR_LANGCACHE=true

# App hosts. Redis Cloud backs data/services, but it does not host this Node HTTP API.
# For local dev use http://127.0.0.1:3030; for cloud app hosting set ATTACK_KB_SERVER_URL=https://<host>.
PORT=3000
ATTACK_KB_PORT=3030
ATTACK_KB_SERVER_URL=http://127.0.0.1:3030
ATTACK_KB_CURATION_UI_PORT=3010
ATTACK_KB_DEMO_PORT=3020

# --- Fix Agent (Cursor Background / Cloud Agents) ---
# Closes the red-team loop: takes attack traces and dispatches a Cursor Cloud
# Agent that opens a PR fixing agents/loan_approval_agent/.
# API key from the Cursor dashboard -> Integrations -> Background Agents API.
CURSOR_API_KEY=
# Optional override of the Cursor API base URL.
# CURSOR_API_URL=https://api.cursor.com
# GitHub repo the fix agent operates on (defaults to this repo's origin).
FIX_AGENT_REPO=https://github.com/bo-bi-beep/weavehacks4-repo
# Branch the Cloud Agent forks from.
FIX_AGENT_REF=main
# Optional model for the Cloud Agent (Cursor picks a sensible default if unset).
# FIX_AGENT_MODEL=claude-4.5-sonnet
# Port for the fix-agent HTTP service.
FIX_AGENT_PORT=3040
# How long POST /fix waits (ms) for the PR url before returning pending. Default 10 min.
FIX_AGENT_WAIT_MS=600000
