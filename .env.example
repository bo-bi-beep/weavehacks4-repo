# W&B / Weave
WANDB_API_KEY=
# Optional — entity (team/user) and project name for the Weave trace destination.
# Defaults to project "weavehacks4-your-idea" with no entity when unset.
WANDB_ENTITY=
WANDB_PROJECT=

# Model providers
OPENAI_API_KEY=
# Main Agent (orchestrator) model — defaults to OpenAI GPT-5.5 when unset.
MAIN_AGENT_MODEL=gpt-5.5
# Sub-agents' model — defaults to gpt-5.4-mini when unset.
OPENAI_MODEL=gpt-5.4-mini

# Skills loaded into agents/main_agent at startup (comma-separated; none/empty to
# disable). Defaults to loan-approval-agent when unset.
# MAIN_AGENT_SKILLS=loan-approval-agent

# Blaxel sandbox (compute backend for agents/main_agent and agents/sub_agents)
BL_API_KEY=
BL_WORKSPACE=
# Optional sandbox tuning (sensible defaults applied when unset)
BLAXEL_SANDBOX_IMAGE=blaxel/base-image
BLAXEL_SANDBOX_MEMORY=4096
# Region defaults to us-pdx-1 (US West). Others: eu-lon-1, us-was-1
BLAXEL_SANDBOX_REGION=us-pdx-1
# Packages apk-installed into every sandbox on creation (the Alpine base image
# has no curl). Space-separated; defaults to "curl", set "none" to disable.
# SANDBOX_APK_PACKAGES=curl
# For main_agent: the sandbox name. For sub_agents: a per-agent name prefix.
# BLAXEL_SANDBOX_NAME=

# Sub-agent registry persistence (agents/sub_agents)
# Unset = in-memory registry: state is lost on restart. Set REDIS_URL to persist
# each agent's identity, skills, and chat history so the service survives a
# restart and can run multiple instances.
# REDIS_URL=redis://localhost:6379
# Optional: expire registry entries (seconds) to match the Blaxel sandbox TTL.
# SUBAGENT_TTL_SECONDS=3600
# Optional: Redis key prefix (default "subagent").
# REDIS_KEY_PREFIX=subagent
# Optional sandbox FILESYSTEM continuity across restarts (separate from the
# registry above). When set, micro-VMs are kept alive on shutdown and the service
# re-attaches to them by name on restart, preserving files written mid-run.
# Leave unset (default) to recreate sandboxes from the stored manifest on
# restart. Enable only once you've confirmed the sandbox client can re-attach.
# SUBAGENT_REATTACH=1

# App
PORT=3000
